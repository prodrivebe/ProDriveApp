# Application
APP_NAME=ProDrive API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_JSON=true

# PostgreSQL
POSTGRES_USER=prodrive
POSTGRES_PASSWORD=prodrive
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=prodrive
DATABASE_URL=postgresql+psycopg://prodrive:prodrive@postgres:5432/prodrive

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# API
API_PORT=8000

# JWT
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# Development seed data
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
SEED_COMPANY_NAME=ProDrive Demo Transport
SEED_BETA=false
SEED_PILOT=false

# Pilot / production operations
PUBLIC_DOMAIN=dispatch.example.com
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=ProDrive is temporarily unavailable for maintenance.
AUTH_RATE_LIMIT_PER_MINUTE=20
FEATURE_AI_ENABLED=true
FEATURE_PLANNING_ENABLED=true
FEATURE_REALTIME_ENABLED=true
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
WEB_PORT=80
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
ALERT_WEBHOOK_URL=

# File uploads
UPLOAD_ROOT_DIR=uploads
MAX_LOGO_SIZE_MB=5
MAX_PHOTO_SIZE_MB=10
MAX_DOCUMENT_SIZE_MB=15

# CORS (dispatcher dashboard dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
